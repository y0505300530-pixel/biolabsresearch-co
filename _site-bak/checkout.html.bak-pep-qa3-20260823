<script>
// ======================== CART ========================
let cart = JSON.parse(localStorage.getItem('biofirst_cart') || '[]');
let selectedPM = 'card';
let currentOrderRef = '';

// Payment details — UPDATE THESE WITH YOUR REAL DETAILS
const PAYMENT_DETAILS = {
  bank: {
    accountNum: '[ACCOUNT_NUMBER]',
    routingACH:  '[ROUTING_ACH]',
    routingWire: '[ROUTING_WIRE]',
    bankName:    '[BANK_NAME]'
  },
  zelle: {
    phone: '[ZELLE_PHONE]'
  },
  crypto: {
    eth: {
      address: '[ETH_WALLET_ADDRESS]',
      qr: 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=[ETH_WALLET_ADDRESS]'
    },
    tron: {
      address: '[TRON_WALLET_ADDRESS]',
      qr: 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=[TRON_WALLET_ADDRESS]'
    }
  }
};

// ======================== INIT ========================
document.addEventListener('DOMContentLoaded', function() {
  renderSummary();
  initCardFormatting();
});

// ======================== SUMMARY ========================
function getSubtotal() {
  return cart.reduce((a, i) => a + (parseFloat(i.price) || 0) * i.qty, 0);
}
function getCardFee() {
  return selectedPM === 'card' ? Math.round(getSubtotal() * 0.035 * 100) / 100 : 0;
}
function getTotal() {
  return getSubtotal(); // No card fee - inquiry only
}

function renderSummary() {
  const el = document.getElementById('summaryItems');
  const totals = document.getElementById('summaryTotals');
  if (!cart.length) {
    el.innerHTML = '<div class="empty-msg"><p>No items in cart.</p><p style="margin-top:8px"><a href="index.html">← Browse peptides</a></p></div>';
    totals.style.display = 'none';
    return;
  }
  el.innerHTML = cart.map(item => {
    const imgHtml = item.imageUrl
      ? `<img src="${item.imageUrl}" alt="${item.name}">`
      : `<span style="font-size:22px">${item.emoji || '🧪'}</span>`;
    return `
      <div class="order-item">
        <div class="oi-img">${imgHtml}</div>
        <div class="oi-info">
          <div class="oi-name">${item.name}</div>
          <div class="oi-qty">$${item.price.toFixed(2)} each</div>
          <div class="oi-qty-controls">
            <button class="oi-qty-btn" onclick="changeQty('${item.name}', -1)">−</button>
            <span class="oi-qty-num">${item.qty}</span>
            <button class="oi-qty-btn" onclick="changeQty('${item.name}', 1)">+</button>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
          <span class="oi-price">$${(item.price * item.qty).toFixed(2)}</span>
          <button class="oi-remove" onclick="removeItem('${item.name}')">✕</button>
        </div>
      </div>`;
  }).join('');
  totals.style.display = 'block';
  const sub = getSubtotal();
  const fee = getCardFee();
  const total = getTotal();
  document.getElementById('sumSubtotal').textContent = '$' + sub.toFixed(2);
  document.getElementById('sumTotal').textContent = '$' + total.toFixed(2);
  const feeRow = document.getElementById('cardFeeRow');
  if (selectedPM === 'card') {
    feeRow.style.display = 'flex';
    document.getElementById('cardFeeVal').textContent = '$' + fee.toFixed(2);
  } else {
    feeRow.style.display = 'none';
  }
}

function changeQty(name, delta) {
  const item = cart.find(i => i.name === name);
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) cart = cart.filter(i => i.name !== name);
  localStorage.setItem('biofirst_cart', JSON.stringify(cart));
  renderSummary();
}
function removeItem(name) {
  cart = cart.filter(i => i.name !== name);
  localStorage.setItem('biofirst_cart', JSON.stringify(cart));
  renderSummary();
}

