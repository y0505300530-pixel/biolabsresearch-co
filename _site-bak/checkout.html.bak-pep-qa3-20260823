}

// ======================== MODAL HELPERS ========================
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    ['bankModal','zelleModal','cryptoModal'].forEach(closeModal);
  }
});
['bankModal','zelleModal','cryptoModal'].forEach(id => {
  document.getElementById(id).addEventListener('click', function(e) {
    if (e.target === this) closeModal(id);
  });
});

function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const orig = btn.textContent;
    btn.textContent = 'Copied!';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
  }).catch(() => {
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
}

// ======================== NOTIFY ADMIN ========================
function notifyAdmin(orderData, paymentMethodLabel) {
  const items = orderData.items.map(i => `${i.name} x${i.qty} = $${(i.price*i.qty).toFixed(2)}`).join('\n');
  const body = `
NEW ORDER — ${orderData.ref}
=================================
Customer: ${orderData.customer.firstName} ${orderData.customer.lastName}
Email: ${orderData.customer.email}
Phone: ${orderData.customer.phone || 'N/A'}
Company: ${orderData.customer.company || 'N/A'}

SHIPPING:
${orderData.shipping.address1}${orderData.shipping.address2 ? ', ' + orderData.shipping.address2 : ''}
${orderData.shipping.city}, ${orderData.shipping.state} ${orderData.shipping.zip}
${orderData.shipping.country}

ITEMS:
${items}

Subtotal: $${orderData.subtotal}
Card Fee: $${orderData.cardFee}
TOTAL: $${orderData.total}

Payment: ${paymentMethodLabel}
Notes: ${orderData.notes || 'None'}
Timestamp: ${orderData.timestamp}
  `.trim();

  const subject = `New Order ${orderData.ref} — $${orderData.total} — ${paymentMethodLabel}`;
  fetch(`https://biofirst.co/api/notify-order`, {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ subject, body, orderData, paymentMethod: paymentMethodLabel })
  }).catch(() => {
    // fallback: mailto
    window.open(`mailto:info@biofirst.co?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`);
  });
  // Save order to server for admin dashboard
  fetch(`https://biofirst.co/api/orders`, {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(orderData)
  }).catch(function(){});
  // Save order to server for admin dashboard
  fetch(`https://biofirst.co/api/orders`, {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(orderData)
  }).catch(function(){});
}

// ======================== SUCCESS ========================
function showSuccess(orderData, paymentNote) {
  localStorage.removeItem('biofirst_cart');
  document.getElementById('mainContent').style.display = 'none';
  const ss = document.getElementById('successScreen');
  ss.style.display = 'block';
  document.getElementById('orderRefDisplay').textContent = 'Order #' + orderData.ref;
  document.getElementById('successEmail').textContent = orderData.customer.email;
  document.getElementById('successPaymentNote').textContent = paymentNote;
  window.scrollTo(0, 0);
}
