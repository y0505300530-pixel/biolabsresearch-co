<!DOCTYPE html>
<html lang="en">
<head>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkout | BioFirst Peptides</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --white:#ffffff;
  --cream:#f7f9f5;
  --navy:#0d2137;
  --navy2:#163352;
  --green:#1d5c3a;
  --green2:#2d7a52;
  --green-light:#e8f4ee;
  --green-mid:#c2dece;
  --text:#1a2e1f;
  --muted:#4a6358;
  --border:#d4e4d8;
  --border2:#e8f0ea;
  --error:#c0392b;
  --success:#1d5c3a;
}
html{scroll-behavior:smooth}
body{background:var(--cream);color:var(--text);font-family:'Lato',sans-serif;min-height:100vh}

/* NAV — identical to main site */
.announce{background:var(--navy);color:rgba(255,255,255,0.92);text-align:center;padding:10px 20px;font-size:12px;font-weight:600;letter-spacing:0.8px}
.announce strong{color:#7ecfaa}
nav{background:var(--white);border-bottom:2px solid var(--border);padding:0 60px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:200;box-shadow:0 2px 16px rgba(0,0,0,0.06)}
.logo{display:flex;align-items:center;gap:14px;text-decoration:none;padding:16px 0}
.logo-icon{width:44px;height:44px;border-radius:50%;border:2px solid var(--green);display:flex;align-items:center;justify-content:center}
.logo-icon svg{width:26px;height:26px}
.logo-text{font-family:'Montserrat',sans-serif;font-size:20px;font-weight:800;color:var(--navy);letter-spacing:1px}
.logo-text span{color:var(--green)}
.logo-sub{font-size:9px;font-weight:600;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:block;margin-top:1px}
.back-link{font-size:13px;color:var(--muted);text-decoration:none;display:flex;align-items:center;gap:6px;font-family:'Montserrat',sans-serif;font-weight:600;transition:color .2s}
.back-link:hover{color:var(--green)}
.secure-nav-badge{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);font-family:'Montserrat',sans-serif;font-weight:600}

/* CHECKOUT LAYOUT */
.checkout-page{max-width:1200px;margin:0 auto;padding:48px 40px;display:grid;grid-template-columns:1fr 400px;gap:40px;align-items:start}

/* SECTION HEADERS */
.section-label{font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:2.5px;color:var(--green);text-transform:uppercase;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.section-label::before{content:'';display:block;width:20px;height:2px;background:var(--green)}

/* FORM CARD */
.form-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:32px;margin-bottom:20px}
.form-card h2{font-family:'Montserrat',sans-serif;font-size:16px;font-weight:800;color:var(--navy);margin-bottom:24px;padding-bottom:16px;border-bottom:1.5px solid var(--border2);letter-spacing:0.3px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;font-family:'Montserrat',sans-serif}
.form-group input,
.form-group select{width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;font-family:'Lato',sans-serif;color:var(--text);background:white;transition:border-color .2s;outline:none;appearance:none}
.form-group input:focus,
.form-group select:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(29,92,58,0.08)}
.form-group input.err{border-color:var(--error)}
.form-group .err-msg{font-size:11px;color:var(--error);margin-top:4px;display:none}
.form-group.has-error .err-msg{display:block}
.form-group.has-error input,
.form-group.has-error select{border-color:var(--error)}

/* PAYMENT METHOD SELECTOR */
.payment-method-list{display:flex;flex-direction:column;gap:10px;margin-bottom:8px}
.pm-option{border:1.5px solid var(--border);border-radius:10px;padding:16px 18px;cursor:pointer;transition:all .25s;display:flex;align-items:center;gap:14px;background:var(--white);position:relative}
.pm-option:hover{border-color:var(--green);background:var(--green-light)}
.pm-option.selected{border-color:var(--green);background:var(--green-light);box-shadow:0 0 0 2px rgba(29,92,58,0.15)}
.pm-radio{width:18px;height:18px;border-radius:50%;border:2px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .2s;background:white}
.pm-option.selected .pm-radio{border-color:var(--green);background:var(--green)}
.pm-option.selected .pm-radio::after{content:'';width:7px;height:7px;border-radius:50%;background:white;display:block}
.pm-icon{width:36px;height:36px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.pm-icon svg,.pm-icon img{width:28px;height:28px;object-fit:contain}
.pm-info{flex:1}
.pm-title{font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;color:var(--navy);margin-bottom:2px}
.pm-sub{font-size:12px;color:var(--muted)}
.pm-badges{display:flex;gap:5px;margin-top:4px}
.pm-badge{font-size:9px;font-weight:700;font-family:'Montserrat',sans-serif;padding:2px 7px;border-radius:3px;text-transform:uppercase;letter-spacing:0.5px}
.pm-badge.visa{background:#1a1f71;color:white}
.pm-badge.mc{background:#eb001b;color:white}
.pm-badge.amex{background:#007bc1;color:white}
.pm-badge.crypto{background:#f6851b;color:white}
.pm-badge.usdc{background:#2775ca;color:white}

/* CARD INPUT AREA */
.card-input-area{background:var(--cream);border:1.5px solid var(--border2);border-radius:10px;padding:18px;margin-top:14px;display:none}
.card-input-area.visible{display:block}
.card-input-area .form-group{margin-bottom:12px}
.card-input-area .form-group:last-child{margin-bottom:0}

/* ORDER NOTES */
.order-notes-link{font-size:12px;color:var(--green);cursor:pointer;font-family:'Montserrat',sans-serif;font-weight:600;display:flex;align-items:center;gap:4px;margin-bottom:16px;width:fit-content}
.order-notes-link:hover{text-decoration:underline}
.order-notes-area{display:none;margin-bottom:16px}
.order-notes-area.visible{display:block}
.order-notes-area textarea{width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-family:'Lato',sans-serif;color:var(--text);resize:vertical;min-height:80px;outline:none;transition:border-color .2s}
.order-notes-area textarea:focus{border-color:var(--green)}

/* TERMS */
.terms-block{margin-top:18px;display:flex;flex-direction:column;gap:10px}
.check-row{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--muted);line-height:1.5;cursor:pointer}
.check-row input[type=checkbox]{width:16px;height:16px;flex-shrink:0;margin-top:2px;accent-color:var(--green);cursor:pointer}
.check-row a{color:var(--green);text-decoration:none}
.check-row a:hover{text-decoration:underline}

/* SUBMIT BUTTON */
.btn-submit{width:100%;background:var(--green);color:white;border:none;padding:17px;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;transition:all .25s;margin-top:20px;display:flex;align-items:center;justify-content:center;gap:10px;font-family:'Montserrat',sans-serif;letter-spacing:0.5px;text-transform:uppercase}
.btn-submit:hover:not(:disabled){background:var(--green2);transform:translateY(-2px);box-shadow:0 10px 28px rgba(29,92,58,0.3)}
.btn-submit:disabled{opacity:0.55;cursor:not-allowed;transform:none}
.spinner{width:18px;height:18px;border:2.5px solid rgba(255,255,255,0.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite;display:none}
.btn-submit.loading .spinner{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

/* ORDER SUMMARY SIDEBAR */
.summary-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:28px;position:sticky;top:90px}
.summary-card h2{font-family:'Montserrat',sans-serif;font-size:15px;font-weight:800;color:var(--navy);margin-bottom:22px;padding-bottom:14px;border-bottom:1.5px solid var(--border2)}
.order-item{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border2)}
.oi-img{width:52px;height:52px;border-radius:8px;background:var(--navy);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.oi-img img{width:100%;height:100%;object-fit:cover}
.oi-info{flex:1;min-width:0}
.oi-name{font-size:13px;font-weight:700;color:var(--navy);font-family:'Montserrat',sans-serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.oi-qty{font-size:11px;color:var(--muted);margin-top:3px}
.oi-price{font-size:14px;font-weight:700;color:var(--navy);font-family:'Montserrat',sans-serif;flex-shrink:0;align-self:center}
.oi-qty-controls{display:flex;align-items:center;gap:8px;margin-top:8px}
.oi-qty-btn{width:24px;height:24px;border-radius:4px;border:1.5px solid var(--border);background:none;cursor:pointer;font-size:13px;font-weight:700;color:var(--navy);transition:all .2s;display:flex;align-items:center;justify-content:center}
.oi-qty-btn:hover{background:var(--green);color:white;border-color:var(--green)}
.oi-qty-num{font-size:13px;font-weight:700;min-width:16px;text-align:center;font-family:'Montserrat',sans-serif}
.oi-remove{background:none;border:none;cursor:pointer;color:var(--muted);font-size:13px;padding:4px;transition:color .2s;align-self:flex-start;flex-shrink:0}
.oi-remove:hover{color:var(--error)}

.summary-lines{margin-top:14px}
.sum-line{display:flex;justify-content:space-between;padding:7px 0;font-size:13px;color:var(--muted);font-family:'Montserrat',sans-serif}
.sum-line.fee-line{color:var(--navy)}
.sum-line.fee-line span:last-child{font-weight:600}
.sum-line.total-line{font-size:16px;font-weight:800;color:var(--navy);border-top:2px solid var(--border);padding-top:14px;margin-top:6px}
.sum-line.total-line span:last-child{color:var(--green)}

.trust-strip{display:flex;flex-direction:column;gap:7px;margin-top:22px;padding-top:18px;border-top:1px solid var(--border2)}
.trust-row{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted);font-family:'Montserrat',sans-serif;font-weight:600}
.trust-row svg{width:14px;height:14px;color:var(--green);flex-shrink:0}

.empty-msg{text-align:center;padding:40px 20px;color:var(--muted)}
.empty-msg a{color:var(--green);text-decoration:none;font-weight:600}

/* SUCCESS SCREEN */
.success-screen{display:none;max-width:640px;margin:80px auto;text-align:center;padding:0 20px}
.success-icon-wrap{width:80px;height:80px;border-radius:50%;background:var(--green-light);border:2px solid var(--green-mid);display:flex;align-items:center;justify-content:center;margin:0 auto 24px}
.success-icon-wrap svg{width:40px;height:40px;color:var(--green)}
.success-screen h1{font-family:'Montserrat',sans-serif;font-size:28px;font-weight:900;color:var(--navy);margin-bottom:12px}
.success-screen p{font-size:15px;color:var(--muted);line-height:1.7;margin-bottom:8px}
.order-ref{background:var(--green-light);border:1.5px solid var(--green-mid);border-radius:8px;padding:16px 24px;display:inline-block;margin:20px 0;font-family:'Montserrat',sans-serif;font-weight:800;color:var(--green);font-size:15px}
.btn-back{background:var(--green);color:white;border:none;padding:14px 32px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;font-family:'Montserrat',sans-serif;letter-spacing:0.5px;display:inline-block;margin-top:16px;transition:all .2s}
.btn-back:hover{background:var(--green2)}

/* PAYMENT MODALS */
.modal-overlay{position:fixed;inset:0;background:rgba(13,33,55,0.6);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal-box{background:white;border-radius:16px;max-width:440px;width:100%;padding:32px;position:relative;box-shadow:0 24px 64px rgba(0,0,0,0.2);animation:modalIn .25s ease}
@keyframes modalIn{from{transform:translateY(16px);opacity:0}to{transform:none;opacity:1}}
.modal-close{position:absolute;top:16px;right:16px;background:none;border:none;cursor:pointer;color:var(--muted);font-size:22px;width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.modal-close:hover{background:var(--cream);color:var(--navy)}
.modal-header{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.modal-header-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.modal-header-icon.blue{background:#e8f0fe}
.modal-header-icon.orange{background:#fff3e0}
.modal-header-icon.purple{background:#f3e8fd}
.modal-title{font-family:'Montserrat',sans-serif;font-size:16px;font-weight:800;color:var(--navy)}
.modal-sub{font-size:12px;color:var(--muted);margin-top:2px}

.amount-display{background:var(--cream);border:1.5px solid var(--border);border-radius:10px;padding:16px 18px;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.amount-label{font-size:12px;color:var(--muted);font-family:'Montserrat',sans-serif;font-weight:600}
.amount-val{font-family:'Montserrat',sans-serif;font-size:22px;font-weight:900;color:var(--navy)}

.copy-row{background:var(--cream);border:1.5px solid var(--border);border-radius:8px;padding:14px 16px;margin-bottom:10px}
.copy-row-label{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-family:'Montserrat',sans-serif;margin-bottom:5px}
.copy-row-inner{display:flex;align-items:center;justify-content:space-between;gap:12px}
.copy-val{font-size:14px;font-weight:700;color:var(--navy);font-family:'Montserrat',sans-serif;word-break:break-all}
.btn-copy{background:var(--green);color:white;border:none;padding:7px 16px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;transition:all .2s;flex-shrink:0}
.btn-copy:hover{background:var(--green2)}
.btn-copy.copied{background:#666}

.modal-instructions{font-size:13px;color:var(--muted);line-height:1.75;margin:16px 0}
.modal-instructions strong{color:var(--navy)}

.confirm-check{display:flex;align-items:flex-start;gap:10px;margin:16px 0;font-size:13px;color:var(--muted);cursor:pointer}
.confirm-check input{width:16px;height:16px;flex-shrink:0;margin-top:2px;accent-color:var(--green);cursor:pointer}

.btn-modal-confirm{width:100%;background:var(--navy);color:white;border:none;padding:15px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Montserrat',sans-serif;letter-spacing:0.5px;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.btn-modal-confirm:hover:not(:disabled){background:var(--navy2)}
.btn-modal-confirm:disabled{opacity:0.5;cursor:not-allowed}

/* CRYPTO CHAIN SELECTOR */
.chain-selector{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.chain-opt{border:1.5px solid var(--border);border-radius:10px;padding:14px 16px;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:12px}
.chain-opt:hover{border-color:var(--green)}
.chain-opt.selected{border-color:var(--green);background:var(--green-light)}
.chain-icon{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px}
.chain-name{font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;color:var(--navy)}
.chain-sub{font-size:11px;color:var(--muted)}
.check-mark{margin-left:auto;width:20px;height:20px;border-radius:50%;background:var(--green);display:none;align-items:center;justify-content:center}
.chain-opt.selected .check-mark{display:flex}

/* QR CODE */
.qr-wrap{background:white;border:1.5px solid var(--border);border-radius:10px;padding:20px;text-align:center;margin-bottom:14px}
.qr-wrap img{width:160px;height:160px;margin-bottom:8px}
.qr-hint{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted);font-family:'Montserrat',sans-serif}

.btn-sent{width:100%;background:transparent;color:var(--green);border:2px solid var(--green);padding:14px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Montserrat',sans-serif;transition:all .2s;margin-top:8px}
.btn-sent:hover{background:var(--green);color:white}

/* RESPONSIVE */
@media(max-width:960px){.checkout-page{grid-template-columns:1fr;padding:32px 20px}}
@media(max-width:640px){nav{padding:0 20px}.form-row{grid-template-columns:1fr}}
#pm-bank, #pm-zelle, #pm-crypto { display: none !important; }
.card-input-area { display: none !important; }
#pm-card { display: none !important; }
</style>
</head>
<body>

<div class="announce">
  <strong>Research Use Only</strong> — All peptides are for research purposes only &nbsp;|&nbsp; Third-party HPLC tested &nbsp;|&nbsp; COA included with every order
</div>

<nav>
  <a class="logo" href="index.html">
    <div class="logo-icon" style="border:none;background:transparent;width:48px;height:48px;"><img src="/biofirst-logo.png" alt="BioFirst" style="width:100%;height:100%;object-fit:contain;"/></div>
    <div>
      <div class="logo-text">Bio<span>First</span></div>
      <div class="logo-sub">Science First. Research Always.</div>
    </div>
  </a>
  <a href="index.html" class="back-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Back to Shop
  </a>
  <div class="secure-nav-badge">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
    Secure Checkout
  </div>
</nav>

<!-- MAIN CONTENT -->
<div id="mainContent">
  <div class="checkout-page">

    <!-- LEFT: FORM -->
    <div>
      <!-- CONTACT INFO -->
      <div class="form-card">
        <div class="section-label">Step 1</div>
        <h2>Contact Information</h2>
        <div class="form-row">
          <div class="form-group">
            <label>First Name *</label>
            <input type="text" id="firstName" placeholder="John">
            <div class="err-msg">Required</div>
          </div>
          <div class="form-group">
            <label>Last Name *</label>
            <input type="text" id="lastName" placeholder="Smith">
            <div class="err-msg">Required</div>
          </div>
        </div>
        <div class="form-group">
          <label>Email Address *</label>
          <input type="email" id="email" placeholder="john@example.com">
          <div class="err-msg">Valid email required</div>
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input type="tel" id="phone" placeholder="+1 234 567 8900">
        </div>
        <div class="form-group">
          <label>Company / Clinic (optional)</label>
          <input type="text" id="company" placeholder="Your clinic or company name">
        </div>
      </div>

      <!-- SHIPPING ADDRESS -->
      <div class="form-card">
        <div class="section-label">Step 2</div>
        <h2>Shipping Address</h2>
        <div class="form-group">
          <label>Address Line 1 *</label>
          <input type="text" id="address1" placeholder="123 Main Street">
          <div class="err-msg">Required</div>
        </div>
        <div class="form-group">
          <label>Address Line 2</label>
          <input type="text" id="address2" placeholder="Apt, Suite, etc. (optional)">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>City *</label>
            <input type="text" id="city" placeholder="New York">
            <div class="err-msg">Required</div>
          </div>
          <div class="form-group">
            <label>State / Region *</label>
            <input type="text" id="state" placeholder="NY">
            <div class="err-msg">Required</div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Postal Code *</label>
            <input type="text" id="zip" placeholder="10001">
            <div class="err-msg">Required</div>
          </div>
          <div class="form-group">
            <label>Country *</label>
            <select id="country">
              <option value="">Select country</option>
              <option value="US">United States</option>
              <option value="GB">United Kingdom</option>
              <option value="DE">Germany</option>
              <option value="FR">France</option>
              <option value="ES">Spain</option>
              <option value="IT">Italy</option>
              <option value="PL">Poland</option>
              <option value="NL">Netherlands</option>
              <option value="BE">Belgium</option>
              <option value="AT">Austria</option>
              <option value="CH">Switzerland</option>
              <option value="CZ">Czech Republic</option>
              <option value="HU">Hungary</option>
              <option value="RO">Romania</option>
              <option value="PT">Portugal</option>
