}
.split-link{font-size:14px;font-weight:600;color:var(--bronze)}

/* ===== PROCESS STRIP ===== */
.process-section{background:var(--bg);padding:88px 48px}
.process-grid{
  list-style:none;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  margin:0;
  padding:0;
}
