/* ===== SHARED SECTION CHROME ===== */
.section-inner{max-width:var(--maxw);margin:0 auto}
.section-head{max-width:720px;margin-bottom:40px}
.section-kicker{
  font-size:12px;
  font-weight:700;
  letter-spacing:1.5px;
  text-transform:uppercase;
  color:var(--bronze);
  margin-bottom:12px;
}
.section-head h2{
  font-size:clamp(32px,5vw,52px);
  font-weight:600;
  letter-spacing:-1.4px;
  line-height:1.08;
  margin-bottom:12px;
}
.section-head p{font-size:17px;color:var(--ink-soft);line-height:1.5}

/* ===== METHOD CARDS — Identity. Purity. Residuals. ===== */
.method-section{
  background:var(--bg-warm);
  padding:88px 48px;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}
.method-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}
.method-tile{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:36px 32px 28px;
  box-shadow:var(--shadow-sm);
  min-height:280px;
  display:flex;
  flex-direction:column;
}
.method-kicker{
  font-size:12px;
  font-weight:700;
  letter-spacing:1.2px;
  text-transform:uppercase;
  color:var(--bronze);
  margin-bottom:10px;
}
.method-num{
  font-size:clamp(36px,4.5vw,52px);
  font-weight:700;
  letter-spacing:-1.8px;
  line-height:1;
  color:var(--ink);
  margin-bottom:16px;
}
.method-lead{
  font-size:15px;
  color:var(--ink-soft);
  line-height:1.5;
  flex:1;
}
.method-field{
  margin-top:24px;
  padding-top:16px;
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:12px;
}
.method-field span{font-size:12px;color:var(--ink-muted);letter-spacing:.2px}
.method-field strong{font-size:13px;font-weight:700;color:var(--bronze)}

/* ===== CHEMISTRY TABLE ===== */
.chem-section{background:var(--bg);padding:88px 48px}
.chem-wrap{
  overflow-x:auto;
  border:1px solid var(--border);
  border-radius:var(--radius);
  background:#fff;
}
.chem-table{
  width:100%;
  border-collapse:collapse;
  min-width:720px;
}
.chem-table th{
  text-align:left;
  font-size:11px;
  font-weight:700;
  letter-spacing:1.1px;
  text-transform:uppercase;
  color:var(--bronze);
  padding:18px 22px;
  background:var(--bg-warm);
  border-bottom:1px solid var(--border);
}
.chem-table td{
  padding:18px 22px;
  font-size:14px;
  color:var(--ink-soft);
  border-bottom:1px solid var(--border-light);
