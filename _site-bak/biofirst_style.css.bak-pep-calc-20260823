  line-height:1.45;
}
.chem-table tr:last-child td{border-bottom:none}
.chem-table td:first-child{font-weight:600;color:var(--ink);min-width:200px}
.chem-table td:last-child{font-weight:700;color:var(--ink);white-space:nowrap}
.chem-table a{border-bottom:1px solid transparent}
.chem-table a:hover{color:var(--bronze);border-bottom-color:var(--bronze)}
.chem-note{margin-top:16px;font-size:13px;color:var(--ink-muted);max-width:760px}

/* ===== SINGLES VS BLEND ===== */
.split-section{background:var(--bg-warm);padding:88px 48px}
.split-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.split-card{
  display:flex;
