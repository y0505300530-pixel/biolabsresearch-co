  margin-bottom:14px;
}
.process-grid h3{
  font-size:22px;
  font-weight:600;
  letter-spacing:-.4px;
  margin-bottom:10px;
}
.process-grid p{font-size:14px;color:var(--ink-soft);line-height:1.5}
.process-grid a{color:var(--bronze);font-weight:600}

/* ===== CATALOG ATC ===== */
.product-card-atc{
  background:var(--ink);
