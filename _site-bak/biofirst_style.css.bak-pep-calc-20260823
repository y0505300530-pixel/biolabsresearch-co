/* BioFirst — Hims-Strength Redesign v4.0
   "Research, without the noise."
   No sage green. No medical claims. RUO only. */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap');

*{margin:0;padding:0;box-sizing:border-box}

:root{
  --bg:#FFFFFF;
  --bg-warm:#F5F2ED;
  --bg-warm2:#EFE9E0;
  --ink:#1F1F1F;
  --ink-soft:#4A4A4A;
  --ink-muted:#8A8A8A;
  --amber:#FBCF87;
  --bronze:#9A6D2A;
  --brown:#3E2B20;
  --brown-light:#5C4636;
  --border:#E8E2D8;
  --border-light:#F0EBE2;
  --radius:24px;
  --radius-sm:12px;
  --radius-pill:999px;
  --font-display:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-logo:'Fraunces',Georgia,serif;
  --maxw:1280px;
  --transition:all .35s cubic-bezier(.25,.46,.45,.94);
  --shadow-sm:0 1px 3px rgba(31,31,31,.04);
  --shadow-md:0 4px 24px rgba(31,31,31,.06);
  --shadow-lg:0 12px 48px rgba(31,31,31,.08);
  --shadow-xl:0 24px 80px rgba(31,31,31,.10);
}

html{scroll-behavior:smooth}
body{
  font-family:var(--font-display);
  color:var(--ink);
  background:var(--bg);
  line-height:1.6;
  font-size:16px;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

a{color:inherit;text-decoration:none}

/* ===== RUO BAR — thin black strip ===== */
.ruo-bar{
  background:var(--ink);
  color:rgba(255,255,255,.7);
  text-align:center;
  padding:8px 20px;
  font-size:11px;
  font-weight:500;
  letter-spacing:.5px;
}
.ruo-bar strong{color:var(--amber);font-weight:600;letter-spacing:.8px}

/* ===== NAV — minimal: logo + hamburger + cart ===== */
.nav{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border-light);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:20px 48px;
}
.nav-logo{
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  color:inherit;
}
.nav-logo img{width:36px;height:36px;object-fit:contain}
.nav-logo-text{
  font-family:var(--font-logo);
  font-size:22px;
  font-weight:500;
  color:var(--ink);
  letter-spacing:-.5px;
  text-transform:lowercase;
}
.nav-right{display:flex;align-items:center;gap:20px}
.nav-cart{
  background:transparent;
  border:none;
  font-family:var(--font-display);
  font-size:14px;
  font-weight:500;
  color:var(--ink);
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px 4px;
  transition:var(--transition);
}
.nav-cart:hover{opacity:.6}
.nav-cart-count{background:var(--sage);
  background:var(--ink);
  color:#fff;
  font-size:11px;
  font-weight:600;
  border-radius:var(--radius-pill);
  padding:2px 8px;
  min-width:20px;
  text-align:center;
}
.nav-hamburger{
  background:transparent;
  border:none;
  cursor:pointer;
  display:flex;
  flex-direction:column;
  gap:5px;
  padding:8px 4px;
}
.nav-hamburger span{
  width:22px;
  height:1.5px;
  background:var(--ink);
  transition:var(--transition);
}
.nav-menu{
  position:fixed;
  top:0;
  right:-100%;
  width:320px;
  max-width:85vw;
  height:100vh;
  background:var(--bg);
  z-index:10001;
  transition:right .4s cubic-bezier(.25,.46,.45,.94);
  display:flex;
  flex-direction:column;
  padding:80px 40px 40px;
  box-shadow:var(--shadow-xl);
}
.nav-menu.open{right:0}
.nav-menu-close{
  position:absolute;
  top:24px;
  right:24px;
  background:transparent;
  border:none;
  font-size:24px;
  cursor:pointer;
  color:var(--ink);
}
.nav-menu a{
  font-size:20px;
  font-weight:500;
  color:var(--ink);
  padding:16px 0;
  border-bottom:1px solid var(--border-light);
  transition:var(--transition);
}
.nav-menu a:hover{color:var(--bronze)}
.nav-overlay{
  position:fixed;
  inset:0;
  background:rgba(31,31,31,.3);
  z-index:10000;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
.nav-overlay.open{opacity:1;pointer-events:auto}

/* ===== HERO — one headline + 2 cards ===== */
.hero{
  max-width:var(--maxw);
  margin:0 auto;
  padding:80px 48px 100px;
}
.hero-headline{
  font-family:var(--font-display);
  font-size:clamp(40px,7vw,72px);
  font-weight:500;
  line-height:1.02;
  letter-spacing:-2px;
  color:var(--ink);
  margin-bottom:16px;
  max-width:800px;
}
.hero-sub{
  font-size:18px;
  color:var(--ink-soft);
  margin-bottom:48px;
  max-width:500px;
  line-height:1.5;
}
.hero-cta{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:var(--ink);
  color:#fff;
  padding:14px 32px;
  border-radius:var(--radius-pill);
  font-size:14px;
  font-weight:600;
  letter-spacing:.3px;
  transition:var(--transition);
  margin-bottom:64px;
}
.hero-cta:hover{background:#000;transform:translateY(-1px);box-shadow:var(--shadow-md)}
.hero-cta svg{width:14px;height:14px}

.hero-cards{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:24px;
}
.hero-card{
  position:relative;
  border-radius:var(--radius);
  overflow:hidden;
  aspect-ratio:4/3;
  background:var(--bg-warm);
  transition:var(--transition);
  cursor:pointer;
}
.hero-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.hero-card img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
  transition:transform .6s ease;
}
.hero-card-blends img{
  object-fit:contain;
  object-position:center center;
  background:#2A1E15;
}
.hero-card:hover img{transform:scale(1.02)}
.hero-card-blends:hover img{transform:scale(1.01)}
.hero-card-overlay{
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  padding:32px;
  background:linear-gradient(to top,rgba(31,31,31,.7) 0%,rgba(31,31,31,0) 100%);
  display:flex;
  flex-direction:column;
  gap:8px;
}
.hero-card-title{
  font-size:22px;
  font-weight:600;
  color:#fff;
  letter-spacing:-.3px;
}
.hero-card-link{
  font-size:13px;
  font-weight:500;
  color:var(--amber);
  display:flex;
  align-items:center;
  gap:6px;
}
.hero-card-blends{background:var(--brown)}
.hero-card-singles{background:var(--bg-warm2)}
.hero-card-singles .hero-card-title{color:var(--ink)}
.hero-card-singles .hero-card-link{color:var(--bronze)}
.hero-card-singles .hero-card-overlay{background:linear-gradient(to top,rgba(245,242,237,.95) 0%,rgba(245,242,237,0) 100%)}


/* ===== FULL-BLEED PRODUCT SECTION ===== */
.compounds-section{
  position:relative;
  min-height:72vh;
  background:linear-gradient(120deg,var(--brown) 0%,#2A1E15 55%,#C4A574 100%);
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:80px 48px;
}
.compounds-photo{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  opacity:.35;
  pointer-events:none;
}
.compounds-copy{position:relative;z-index:1;text-align:center}
.compounds-title{
  font-family:var(--font-display);
  font-size:clamp(36px,6vw,64px);
  font-weight:500;
  color:#fff;
  letter-spacing:-1.8px;
  line-height:1.08;
}
.compounds-title em{font-style:normal;color:var(--amber)}
.compounds-sub{display:none}

/* ===== CATALOG — clean 2x3 grid ===== */
.catalog-section{
  max-width:var(--maxw);
  margin:0 auto;
  padding:88px 48px 120px;
}
.catalog-header{
  margin-bottom:60px;
}
.catalog-title{
  font-family:var(--font-display);
  font-size:clamp(32px,5vw,48px);
  font-weight:700;
  color:var(--ink);
  letter-spacing:-1px;
  line-height:1.1;
}
.catalog-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
}
.product-card{
  display:flex;
  flex-direction:column;
  text-decoration:none;
  color:inherit;
  transition:var(--transition);
}
.product-card:hover{transform:translateY(-4px)}
.product-card-media{display:block}
.product-card-img{
  width:100%;
  aspect-ratio:4/5;
  background:var(--bg-warm);
  border-radius:var(--radius);
  overflow:hidden;
  margin-bottom:18px;
}
.product-card-img img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .6s ease;
}
.product-card:hover .product-card-img img{transform:scale(1.04)}
.product-card-name{
  font-size:18px;
  font-weight:600;
  color:var(--ink);
  margin-bottom:8px;
  letter-spacing:-.3px;
  display:block;
}
.product-card-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}
.product-card-price{
  font-size:16px;
  color:var(--ink);
  font-weight:600;
}
.product-card-original{
  text-decoration:line-through;
  color:var(--ink-muted);
  font-weight:400;
  margin-left:6px;
}
.product-card-badge{
  display:inline-block;
  background:var(--amber);
  color:var(--ink);
  font-size:10px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.8px;
  padding:4px 10px;
  border-radius:var(--radius-pill);
  margin-bottom:8px;
  width:fit-content;
}

/* ===== FOOTER ===== */
.footer{
  background:var(--ink);
  color:rgba(255,255,255,.5);
  padding:80px 48px 40px;
}
.footer-inner{
  max-width:var(--maxw);
  margin:0 auto;
}
.footer-top{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:48px;
  margin-bottom:60px;
}
.footer-brand-text{
  font-family:var(--font-logo);
  font-size:24px;
  font-weight:500;
  color:#fff;
  text-transform:lowercase;
  margin-bottom:12px;
}
.footer-brand-desc{
  font-size:14px;
  line-height:1.6;
  max-width:300px;
  margin-bottom:20px;
}
.footer-address{
  font-size:13px;
  color:rgba(255,255,255,.4);
  line-height:1.8;
}
.footer-col h4{
  font-size:13px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:1px;
  color:rgba(255,255,255,.8);
  margin-bottom:16px;
}
.footer-col a{
  display:block;
  color:rgba(255,255,255,.5);
  font-size:14px;
  padding:6px 0;
  transition:var(--transition);
}
.footer-col a:hover{color:#fff}
.footer-bottom{
  border-top:1px solid rgba(255,255,255,.08);
  padding-top:32px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:16px;
}
.footer-disclaimer{
  font-size:13px;
  color:rgba(255,255,255,.62);
  max-width:680px;
  line-height:1.65;
}
.footer-legal-links{
  display:flex;
  gap:24px;
  font-size:13px;
}
.footer-legal-links a{
  color:rgba(255,255,255,.4);
  transition:var(--transition);
}
.footer-legal-links a:hover{color:#fff}

/* ===== CART DRAWER ===== */
.cart-overlay{
  position:fixed;
  inset:0;
  background:rgba(31,31,31,.4);
  backdrop-filter:blur(4px);
  z-index:9999;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
.cart-overlay.open{opacity:1;pointer-events:auto}
.cart-drawer{
  position:fixed;
  top:0;
  right:-480px;
  width:420px;
  max-width:100%;
  height:100vh;
  background:var(--bg);
  z-index:10000;
  transition:right .4s cubic-bezier(.25,.46,.45,.94);
  display:flex;
  flex-direction:column;
  box-shadow:var(--shadow-xl);
}
.cart-drawer.open{right:0}
.cart-header{
  padding:24px 28px;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.cart-title{font-size:18px;font-weight:600;color:var(--ink)}
.cart-close{background:none;border:none;font-size:22px;cursor:pointer;color:var(--ink-muted);transition:var(--transition)}
.cart-close:hover{color:var(--ink)}
.cart-items{flex:1;overflow-y:auto;padding:28px}
.cart-empty{text-align:center;color:var(--ink-muted);padding:60px 20px;font-size:15px}
.cart-empty svg{width:48px;height:48px;margin:0 auto 16px;opacity:.3}
.cart-item{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--border-light)}
.cart-item img{width:72px;height:72px;border-radius:var(--radius-sm);object-fit:cover;background:var(--bg-warm)}
.cart-item-info{flex:1}
.cart-item-name{font-size:15px;font-weight:600;color:var(--ink)}
.cart-item-price{font-size:13px;color:var(--ink-soft);font-weight:500;margin-top:4px}
.cart-item-qty{display:flex;align-items:center;gap:12px;margin-top:8px}
.cart-item-qty button{background:var(--bg-warm);border:none;width:28px;height:28px;border-radius:8px;cursor:pointer;font-size:16px;color:var(--ink);display:flex;align-items:center;justify-content:center}
.cart-item-qty button:hover{background:var(--bg-warm2)}
.cart-item-remove{background:none;border:none;color:var(--ink-muted);cursor:pointer;font-size:14px;align-self:flex-start}
.cart-footer{padding:24px 28px;border-top:1px solid var(--border)}
.cart-subtotal{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.cart-subtotal span{font-size:15px;color:var(--ink-soft)}
.cart-subtotal strong{font-size:24px;font-weight:700;color:var(--ink)}
.btn-checkout{
  background:var(--ink);
  color:#fff;
  border:none;
  border-radius:var(--radius-pill);
  padding:16px;
  font-family:var(--font-display);
  font-size:14px;
  font-weight:600;
  cursor:pointer;
  transition:var(--transition);
  width:100%;
}
.btn-checkout:hover{background:#000;transform:translateY(-1px);box-shadow:var(--shadow-md)}
.cart-note{font-size:12px;color:var(--ink-muted);text-align:center;margin-top:12px}

/* ===== SCROLL ANIMATIONS ===== */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.hero-headline,.hero-sub,.hero-cta,.hero-cards{animation:fadeUp .7s cubic-bezier(.25,.46,.45,.94) backwards}
.hero-headline{animation-delay:.1s}
.hero-sub{animation-delay:.2s}
.hero-cta{animation-delay:.3s}
.hero-cards{animation-delay:.4s}

/* ===== RESPONSIVE ===== */
@media(max-width:1024px){
  .hero{padding:60px 32px 80px}
  .hero-cards{grid-template-columns:1fr}
  .catalog-grid{grid-template-columns:repeat(2,1fr)}
  .footer-top{grid-template-columns:1fr 1fr;gap:32px}
}
@media(max-width:768px){
  .nav{padding:16px 20px}
  .nav-logo-text{font-size:20px}
  .hero{padding:40px 20px 60px}
  .hero-headline{font-size:38px}
  .hero-sub{font-size:16px}
  .compounds-section{padding:80px 20px}
  .compounds-title{font-size:32px}
  .catalog-section{padding:60px 20px}
  .catalog-grid{grid-template-columns:1fr;max-width:400px;margin:0 auto}
  .footer{padding:60px 20px 32px}
  .footer-top{grid-template-columns:1fr;gap:32px}
  .footer-bottom{flex-direction:column;align-items:flex-start}
  .cart-drawer{width:100%;right:-100%}
  .ruo-bar{font-size:10px;padding:6px 12px}
}


/* ===== HERO STAT CHIP (Singles card) ===== */
.hero-stat{
  position:absolute;
  right:16px;
  bottom:16px;
  z-index:2;
  background:rgba(255,255,255,.92);
  border:1px solid var(--border);
  border-radius:16px;
  padding:12px 14px 10px;
  min-width:148px;
  box-shadow:var(--shadow-md);
}
.hero-stat-kicker{
  font-size:10px;
  font-weight:700;
  letter-spacing:1px;
  text-transform:uppercase;
  color:var(--bronze);
  margin-bottom:6px;
}
.hero-stat-row{display:flex;gap:16px;align-items:flex-end}
.hero-stat-num{
  font-size:22px;
  font-weight:700;
  letter-spacing:-.6px;
  color:var(--ink);
  line-height:1;
}
.hero-stat-label{
  font-size:11px;
  color:var(--ink-soft);
  margin-top:3px;
}
.hero-stat .sparkline{width:100%;height:22px;margin-top:8px;display:block}
.hero-card-singles .hero-card-overlay{padding-right:180px}

/* ===== STAT STRIP ===== */
.stat-strip{
  background:var(--bg-warm);
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:72px 48px;
}
.stat-strip-inner{
  max-width:var(--maxw);
  margin:0 auto;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}
.stat-tile{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:32px 28px 24px;
  box-shadow:var(--shadow-sm);
}
.stat-num{
  font-size:clamp(40px,5vw,56px);
  font-weight:700;
  letter-spacing:-2px;
  color:var(--ink);
  line-height:1;
}
.stat-label{
  font-size:15px;
  color:var(--ink-soft);
  margin:10px 0 16px;
  font-weight:500;
}
.stat-tile .sparkline{width:88px;height:28px;display:block}
.stat-asterisk{
  max-width:var(--maxw);
  margin:24px auto 0;
  font-size:12px;
  color:var(--ink-muted);
}

/* ===== COA FULL BLEED ===== */
.coa-bleed{
  position:relative;
  min-height:72vh;
  background:#1a120c;
  overflow:hidden;
  padding:88px 48px;
  display:flex;
  align-items:center;
}
.coa-bleed-bg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  opacity:.42;
  pointer-events:none;
}
.coa-bleed-shade{
  position:absolute;
  inset:0;
  background:linear-gradient(120deg,rgba(20,14,10,.82) 0%,rgba(62,43,32,.55) 55%,rgba(20,14,10,.75) 100%);
}
.coa-bleed-inner{
  position:relative;
  z-index:1;
  max-width:var(--maxw);
  margin:0 auto;
  width:100%;
}
.coa-kicker{
  font-size:12px;
  font-weight:700;
  letter-spacing:1.6px;
  text-transform:uppercase;
  color:var(--amber);
  margin-bottom:16px;
}
.coa-headline{
  font-size:clamp(44px,7vw,80px);
  font-weight:500;
  letter-spacing:-2.4px;
  line-height:1.02;
  color:#fff;
  max-width:16ch;
  margin-bottom:20px;
}
.coa-sub{
  font-size:18px;
  color:rgba(255,255,255,.72);
  max-width:560px;
  line-height:1.55;
  margin-bottom:36px;
}
.coa-graph-card{
  background:rgba(14,10,8,.55);
  border:1px solid rgba(251,207,135,.22);
  border-radius:var(--radius);
  padding:20px 22px 12px;
  max-width:720px;
  backdrop-filter:blur(8px);
}
.coa-graph{width:100%;height:auto;display:block}
.coa-note{
  margin-top:16px;
  font-size:12px;
  color:rgba(255,255,255,.5);
}

/* ===== RESEARCH CATEGORY TILES ===== */
.research-cats{
  background:var(--bg);
  padding:100px 48px;
}
.research-cats-inner{max-width:var(--maxw);margin:0 auto}
.research-cats-head{margin-bottom:40px;max-width:640px}
.research-cats-head h2{
  font-size:clamp(32px,5vw,52px);
  font-weight:600;
  letter-spacing:-1.4px;
  line-height:1.08;
  margin-bottom:12px;
}
.research-cats-head p{font-size:17px;color:var(--ink-soft)}
.cat-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
}
.cat-tile{
  display:flex;
  flex-direction:column;
  background:var(--bg-warm);
  border-radius:var(--radius);
  overflow:hidden;
  border:1px solid var(--border-light);
  transition:var(--transition);
}
