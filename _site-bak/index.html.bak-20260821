<div id="coa-request-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:9998;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:12px;width:90%;max-width:480px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <!-- Header -->
    <div style="padding:20px 24px;border-bottom:1px solid #e8f0ea">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <div>
          <div style="font-size:11px;font-weight:700;color:#1d5c3a;letter-spacing:1px;text-transform:uppercase">Certificate of Analysis</div>
          <div style="font-size:18px;font-weight:700;color:#0d2137;margin-top:2px">Request COA</div>
        </div>
        <button onclick="closeCOARequest()" style="background:none;border:none;cursor:pointer;padding:4px;color:#4a6358;font-size:20px;line-height:1">&#x2715;</button>
      </div>
      <p style="font-size:13px;color:#6a8270;margin:8px 0 0">Enter your details and we will send the Certificate of Analysis for <strong id="coa-req-product" style="color:#0d2137">this product</strong> directly to your inbox.</p>
    </div>
    <!-- Form -->
    <form id="coa-request-form" onsubmit="submitCOARequest(event)" style="padding:20px 24px;display:flex;flex-direction:column;gap:14px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div style="display:flex;flex-direction:column;gap:4px">
          <label style="font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;color:#0d2137;text-transform:uppercase;letter-spacing:0.8px">First Name *</label>
          <input type="text" id="coa-req-first" required style="border:1.5px solid #dde7e2;border-radius:8px;padding:10px 12px;font-size:14px;font-family:'Inter',sans-serif;color:#0d2137;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#1d5c3a'" onblur="this.style.borderColor='#dde7e2'">
        </div>
        <div style="display:flex;flex-direction:column;gap:4px">
          <label style="font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;color:#0d2137;text-transform:uppercase;letter-spacing:0.8px">Last Name *</label>
          <input type="text" id="coa-req-last" required style="border:1.5px solid #dde7e2;border-radius:8px;padding:10px 12px;font-size:14px;font-family:'Inter',sans-serif;color:#0d2137;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#1d5c3a'" onblur="this.style.borderColor='#dde7e2'">
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:4px">
        <label style="font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;color:#0d2137;text-transform:uppercase;letter-spacing:0.8px">Email *</label>
        <input type="email" id="coa-req-email" required style="border:1.5px solid #dde7e2;border-radius:8px;padding:10px 12px;font-size:14px;font-family:'Inter',sans-serif;color:#0d2137;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#1d5c3a'" onblur="this.style.borderColor='#dde7e2'">
      </div>
      <div style="display:flex;flex-direction:column;gap:4px">
        <label style="font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;color:#0d2137;text-transform:uppercase;letter-spacing:0.8px">Company / Institution</label>
        <input type="text" id="coa-req-org" style="border:1.5px solid #dde7e2;border-radius:8px;padding:10px 12px;font-size:14px;font-family:'Inter',sans-serif;color:#0d2137;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#1d5c3a'" onblur="this.style.borderColor='#dde7e2'">
      </div>
      <div style="display:flex;flex-direction:column;gap:4px">
        <label style="font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;color:#0d2137;text-transform:uppercase;letter-spacing:0.8px">Message</label>
        <textarea id="coa-req-msg" rows="3" placeholder="Any specific lot numbers or batch requirements?" style="border:1.5px solid #dde7e2;border-radius:8px;padding:10px 12px;font-size:14px;font-family:'Inter',sans-serif;color:#0d2137;outline:none;transition:border-color .2s;resize:vertical;line-height:1.5" onfocus="this.style.borderColor='#1d5c3a'" onblur="this.style.borderColor='#dde7e2'"></textarea>
      </div>
      <button type="submit" id="coa-req-submit" style="background:#1d5c3a;color:white;border:none;border-radius:8px;padding:13px 28px;font-size:13px;font-weight:700;font-family:'Montserrat',sans-serif;letter-spacing:0.5px;cursor:pointer;transition:all .2s;text-transform:uppercase">
        <span id="coa-req-btn-text">Send Request</span>
      </button>
      <div id="coa-req-success" style="display:none;align-items:center;gap:10px;font-size:13px;color:#1d5c3a;font-weight:600;background:#e8f4ee;border-radius:8px;padding:12px 16px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1d5c3a" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Request sent! We will email your COA shortly.
      </div>
    </form>
  </div>
</div>

<script>
var coaRequestProduct = '';
function openCOARequest(productName) {
  coaRequestProduct = productName || '';
  document.getElementById('coa-req-product').textContent = productName || 'this product';
  document.getElementById('coa-request-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeCOARequest() {
  document.getElementById('coa-request-modal').style.display = 'none';
  document.body.style.overflow = '';
}
function submitCOARequest(e) {
  e.preventDefault();
  var btn = document.getElementById('coa-req-submit');
  var txt = document.getElementById('coa-req-btn-text');
  btn.disabled = true;
  txt.textContent = 'Sending...';
  var payload = {
    firstName: document.getElementById('coa-req-first').value,
    lastName:  document.getElementById('coa-req-last').value,
    email:     document.getElementById('coa-req-email').value,
    org:       document.getElementById('coa-req-org').value,
    subject:   'COA Request - ' + (coaRequestProduct || 'General'),
    message:   (document.getElementById('coa-req-msg').value || '') + ' [Product: ' + (coaRequestProduct || 'General') + ']'
  };
  fetch('https://biofirst.co/api/contact', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    btn.disabled = false;
    txt.textContent = 'Send Request';
    document.getElementById('coa-req-success').style.display = 'flex';
    document.getElementById('coa-request-form').reset();
    setTimeout(function() {
      document.getElementById('coa-req-success').style.display = 'none';
      closeCOARequest();
    }, 3000);
  })
  .catch(function() {
    btn.disabled = false;
    txt.textContent = 'Send Request';
    document.getElementById('coa-req-success').style.display = 'flex';
    document.getElementById('coa-request-form').reset();
    setTimeout(function() {
      document.getElementById('coa-req-success').style.display = 'none';
      closeCOARequest();
    }, 3000);
  });
}
document.getElementById('coa-request-modal').addEventListener('click', function(e) {
  if (e.target === this) closeCOARequest();
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeCOARequest();
});
</script>

</body>
</html>
