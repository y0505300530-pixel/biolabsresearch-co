<!-- ENTRY GATE MODAL -->
<style>
.tc-overlay{position:fixed;inset:0;background:rgba(13,33,55,0.88);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.tc-overlay.active{opacity:1;visibility:visible}
.tc-modal{background:#fff;border-radius:16px;max-width:460px;width:100%;padding:40px 36px;text-align:center;box-shadow:0 24px 80px rgba(0,0,0,0.3);transform:translateY(20px);transition:transform .3s;max-height:90vh;overflow-y:auto}
.tc-overlay.active .tc-modal{transform:translateY(0)}
.tc-modal-logo{width:56px;height:56px;border-radius:50%;border:2px solid #1d5c3a;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;background:#f0f7f3}
.tc-modal h2{font-family:'Montserrat',sans-serif;font-size:22px;font-weight:800;color:#0d2137;margin-bottom:10px}
.tc-modal-badge{display:inline-block;background:#e8f4ee;color:#1d5c3a;font-size:11px;font-weight:700;padding:4px 14px;border-radius:20px;letter-spacing:1px;text-transform:uppercase;margin-bottom:18px;font-family:'Montserrat',sans-serif}
.tc-modal-text{font-size:14px;line-height:1.7;color:#4a6358;margin-bottom:24px}
.tc-modal-text strong{color:#0d2137}
.tc-checks{display:flex;flex-direction:column;gap:14px;margin-bottom:24px;text-align:left}
.tc-check-label{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:#4a6358;cursor:pointer;line-height:1.5}
.tc-check-label input{width:18px;height:18px;flex-shrink:0;margin-top:1px;accent-color:#1d5c3a;cursor:pointer}
.tc-check-label a{color:#1d5c3a;text-decoration:underline;font-weight:600}
.tc-enter-btn{width:100%;background:#1d5c3a;color:#fff;border:none;padding:14px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Montserrat',sans-serif;letter-spacing:0.5px;transition:all .2s}
.tc-enter-btn:disabled{opacity:0.4;cursor:not-allowed}
.tc-enter-btn:not(:disabled):hover{background:#2d7a52;transform:translateY(-1px)}
.tc-modal-foot{font-size:11px;color:#999;margin-top:16px}
@media(max-width:480px){.tc-modal{padding:30px 24px}}
</style>

<div class="tc-overlay" id="tcOverlay">
  <div class="tc-modal">
    <div class="tc-modal-logo">
      <svg viewBox="0 0 60 60" fill="none" width="32" height="32">
        <circle cx="30" cy="30" r="28" stroke="#1d5c3a" stroke-width="2" fill="white"/>
        <circle cx="30" cy="30" r="25" fill="#f0f7f3"/>
        <path d="M22 30 C22 24 26 20 30 18 C30 18 28 24 26 28 C24 31 22 32 22 30Z" fill="#1d5c3a"/>
        <path d="M22 30 C22 36 26 40 30 42 C30 42 28 36 26 32 C24 29 22 28 22 30Z" fill="#2d7a52" opacity="0.7"/>
        <path d="M34 16 C38 20 36 24 34 28 C32 32 36 36 34 44" stroke="#1d5c3a" stroke-width="2" fill="none" stroke-linecap="round"/>
        <path d="M38 18 C34 22 36 26 38 30 C40 34 36 38 38 42" stroke="#2d7a52" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
      </svg>
    </div>
    <h2>Welcome to BioFirst</h2>
    <div class="tc-modal-badge">Research Use Only</div>
    <div class="tc-modal-text">
      All products sold by BioFirst are intended strictly for <strong>laboratory research purposes only</strong>. They are not intended for human consumption, diagnostic, therapeutic, or veterinary use. By entering this site, you acknowledge these restrictions.
    </div>
    <div class="tc-checks">
      <label class="tc-check-label">
        <input type="checkbox" id="tcCheck1">
        I am at least <strong>21 years of age</strong> and a qualified researcher.
      </label>
      <label class="tc-check-label">
        <input type="checkbox" id="tcCheck2">
        I have read and agree to the <a href="terms-and-conditions.html" target="_blank">Terms &amp; Conditions</a>.
      </label>
      <label class="tc-check-label">
        <input type="checkbox" id="tcCheck3">
        I confirm all products are for <strong>research use only (RUO)</strong> and not for human consumption.
      </label>
    </div>
    <button class="tc-enter-btn" id="tcEnterBtn" disabled>Enter BioFirst</button>
    <div class="tc-modal-foot">&copy; 2026 BioFirst Ltd. All rights reserved.</div>
  </div>
</div>

<script>
(function(){
  if (localStorage.getItem('biofirst_tc_accepted')) return;
  var overlay = document.getElementById('tcOverlay');
  if (!overlay) return;
  overlay.classList.add('active');
  document.body.style.overflow = 'hidden';
  var c1 = document.getElementById('tcCheck1');
  var c2 = document.getElementById('tcCheck2');
  var c3 = document.getElementById('tcCheck3');
  var btn = document.getElementById('tcEnterBtn');
  function update(){ btn.disabled = !(c1.checked && c2.checked && c3.checked); }
  c1.addEventListener('change', update);
  c2.addEventListener('change', update);
  c3.addEventListener('change', update);
  btn.addEventListener('click', function(){
    if (btn.disabled) return;
    localStorage.setItem('biofirst_tc_accepted', 'true');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  });
})();
</script>
