/* BioFirst — Hims-Strength Redesign v4.0
   "Research, without the noise."
   No sage green. No medical claims. RUO only. */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap');

*{margin:0;padding:0;box-sizing:border-box}

:root{
  --bg:#FFFFFF;
  --bg-warm:#F5F2ED;
  --bg-warm2:#EFE9E0;
  --ink:#1F1F1F;
  --ink-soft:#4A4A4A;
  --ink-muted:#8A8A8A;
  --amber:#FBCF87;
  --bronze:#9A6D2A;
  --sage:#1A4A36;
  --sage-light:#E8F0EA;
  --sage-mid:#C2DECE;
  --brown:#3E2B20;
  --brown-light:#5C4636;
  --border:#E8E2D8;
  --border-light:#F0EBE2;
  --radius:24px;
  --radius-sm:12px;
  --radius-pill:999px;
  --font-display:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-logo:'Fraunces',Georgia,serif;
  --maxw:1280px;
  --transition:all .35s cubic-bezier(.25,.46,.45,.94);
  --shadow-sm:0 1px 3px rgba(31,31,31,.04);
  --shadow-md:0 4px 24px rgba(31,31,31,.06);
  --shadow-lg:0 12px 48px rgba(31,31,31,.08);
  --shadow-xl:0 24px 80px rgba(31,31,31,.10);
}

html{scroll-behavior:smooth}
body{
  font-family:var(--font-display);
  color:var(--ink);
  background:var(--bg);
  line-height:1.6;
  font-size:16px;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

a{color:inherit;text-decoration:none}

/* ===== RUO BAR — thin black strip ===== */
.ruo-bar{
  background:var(--ink);
  color:rgba(255,255,255,.7);
  text-align:center;
  padding:8px 20px;
  font-size:11px;
  font-weight:500;
  letter-spacing:.5px;
}
.ruo-bar strong{color:var(--amber);font-weight:600;letter-spacing:.8px}

/* ===== NAV — minimal: logo + hamburger + cart ===== */
.nav{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border-light);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:20px 48px;
}
.nav-logo{
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  color:inherit;
}
.nav-logo img{width:36px;height:36px;object-fit:contain}
.nav-logo-text{
  font-family:var(--font-logo);
  font-size:22px;
  font-weight:500;
  color:var(--ink);
  letter-spacing:-.5px;
  text-transform:lowercase;
}
.nav-right{display:flex;align-items:center;gap:20px}
.nav-cart{
  background:transparent;
  border:none;
  font-family:var(--font-display);
  font-size:14px;
  font-weight:500;
  color:var(--ink);
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px 4px;
  transition:var(--transition);
}
.nav-cart:hover{opacity:.6}
.nav-cart-count{background:var(--sage);
  background:var(--ink);
  color:#fff;
  font-size:11px;
  font-weight:600;
  border-radius:var(--radius-pill);
  padding:2px 8px;
  min-width:20px;
  text-align:center;
}
.nav-hamburger{
  background:transparent;
  border:none;
  cursor:pointer;
  display:flex;
  flex-direction:column;
  gap:5px;
  padding:8px 4px;
}
.nav-hamburger span{
  width:22px;
  height:1.5px;
  background:var(--ink);
  transition:var(--transition);
}
.nav-menu{
  position:fixed;
  top:0;
  right:-100%;
  width:320px;
  max-width:85vw;
  height:100vh;
  background:var(--bg);
  z-index:10001;
  transition:right .4s cubic-bezier(.25,.46,.45,.94);
  display:flex;
  flex-direction:column;
  padding:80px 40px 40px;
  box-shadow:var(--shadow-xl);
}
.nav-menu.open{right:0}
.nav-menu-close{
  position:absolute;
  top:24px;
  right:24px;
  background:transparent;
  border:none;
  font-size:24px;
  cursor:pointer;
  color:var(--ink);
}
.nav-menu a{
  font-size:20px;
  font-weight:500;
  color:var(--ink);
  padding:16px 0;
  border-bottom:1px solid var(--border-light);
  transition:var(--transition);
}
.nav-menu a:hover{color:var(--bronze)}
.nav-overlay{
  position:fixed;
  inset:0;
  background:rgba(31,31,31,.3);
  z-index:10000;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
.nav-overlay.open{opacity:1;pointer-events:auto}

/* ===== HERO — one headline + 2 cards ===== */
.hero{
  max-width:var(--maxw);
  margin:0 auto;
  padding:80px 48px 100px;
}
.hero-headline{
  font-family:var(--font-display);
  font-size:clamp(40px,7vw,72px);
  font-weight:700;
  line-height:1.05;
  letter-spacing:-1.5px;
  color:var(--ink);
  margin-bottom:16px;
  max-width:800px;
}
.hero-sub{
  font-size:18px;
  color:var(--ink-soft);
  margin-bottom:48px;
  max-width:500px;
  line-height:1.5;
}
.hero-cta{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:var(--ink);
  color:#fff;
  padding:14px 32px;
  border-radius:var(--radius-pill);
  font-size:14px;
  font-weight:600;
  letter-spacing:.3px;
  transition:var(--transition);
  margin-bottom:64px;
}
.hero-cta:hover{background:var(--sage);transform:translateY(-1px);box-shadow:var(--shadow-md)}
.hero-cta svg{width:14px;height:14px}

.hero-cards{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:24px;
}
.hero-card{
  position:relative;
  border-radius:var(--radius);
  overflow:hidden;
  aspect-ratio:4/3;
  background:var(--bg-warm);
  transition:var(--transition);
  cursor:pointer;
}
.hero-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.hero-card img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .6s ease;
}
.hero-card:hover img{transform:scale(1.04)}
.hero-card-overlay{
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  padding:32px;
  background:linear-gradient(to top,rgba(31,31,31,.7) 0%,rgba(31,31,31,0) 100%);
  display:flex;
  flex-direction:column;
  gap:8px;
}
.hero-card-title{
  font-size:22px;
  font-weight:600;
  color:#fff;
  letter-spacing:-.3px;
}
.hero-card-link{
  font-size:13px;
  font-weight:500;
  color:var(--amber);
  display:flex;
  align-items:center;
  gap:6px;
}
.hero-card-blends{background:linear-gradient(135deg,var(--brown) 0%,var(--brown-light) 100%)}
.hero-card-singles{background:linear-gradient(135deg,var(--bg-warm2) 0%,var(--bg-warm) 100%)}

/* ===== FULL-BLEED PRODUCT SECTION ===== */
.compounds-section{
  position:relative;
  background:linear-gradient(160deg,var(--brown) 0%,#2A1E15 100%);
  padding:120px 48px;
  overflow:hidden;
  text-align:center;
}
.compounds-section::before{
  content:'';
  position:absolute;
  top:0;left:0;right:0;bottom:0;
  background:radial-gradient(ellipse at 50% 40%,rgba(154,109,42,.15) 0%,transparent 60%);
}
.compounds-title{
  position:relative;
  font-family:var(--font-display);
  font-size:clamp(36px,6vw,64px);
  font-weight:700;
  color:#fff;
  letter-spacing:-1.5px;
  line-height:1.1;
  margin-bottom:20px;
}
.compounds-sub{
  position:relative;
  font-size:17px;
  color:rgba(255,255,255,.5);
  max-width:480px;
  margin:0 auto;
  line-height:1.5;
}

/* ===== CATALOG — clean 2x3 grid ===== */
.catalog-section{
  max-width:var(--maxw);
  margin:0 auto;
  padding:100px 48px 120px;
}
.catalog-header{
  margin-bottom:60px;
}
.catalog-title{
  font-family:var(--font-display);
  font-size:clamp(32px,5vw,48px);
  font-weight:700;
  color:var(--ink);
  letter-spacing:-1px;
  line-height:1.1;
}
.catalog-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
}
.product-card{
  display:flex;
  flex-direction:column;
  text-decoration:none;
  color:inherit;
  transition:var(--transition);
}
.product-card:hover{transform:translateY(-4px)}
.product-card-img{
  width:100%;
  aspect-ratio:1/1;
  background:var(--bg-warm);
  border-radius:var(--radius);
  overflow:hidden;
  margin-bottom:16px;
}
.product-card-img img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .6s ease;
}
.product-card:hover .product-card-img img{transform:scale(1.04)}
.product-card-name{
  font-size:16px;
  font-weight:600;
  color:var(--ink);
  margin-bottom:4px;
  letter-spacing:-.2px;
}
.product-card-price{
  font-size:14px;
  color:var(--ink-soft);
  font-weight:500;
}
.product-card-original{
  text-decoration:line-through;
  color:var(--ink-muted);
  font-weight:400;
  margin-left:6px;
}
.product-card-badge{
  display:inline-block;
  background:var(--amber);
  color:var(--ink);
  font-size:10px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.8px;
  padding:4px 10px;
  border-radius:var(--radius-pill);
  margin-bottom:8px;
  width:fit-content;
}

/* ===== FOOTER ===== */
.footer{
  background:var(--ink);
  color:rgba(255,255,255,.5);
  padding:80px 48px 40px;
}
.footer-inner{
  max-width:var(--maxw);
  margin:0 auto;
}
.footer-top{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:48px;
  margin-bottom:60px;
}
.footer-brand-text{
  font-family:var(--font-logo);
  font-size:24px;
  font-weight:500;
  color:#fff;
  text-transform:lowercase;
  margin-bottom:12px;
}
.footer-brand-desc{
  font-size:14px;
  line-height:1.6;
  max-width:300px;
  margin-bottom:20px;
}
.footer-address{
  font-size:13px;
  color:rgba(255,255,255,.4);
  line-height:1.8;
}
.footer-col h4{
  font-size:13px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:1px;
  color:rgba(255,255,255,.8);
  margin-bottom:16px;
}
.footer-col a{
  display:block;
  color:rgba(255,255,255,.5);
  font-size:14px;
  padding:6px 0;
  transition:var(--transition);
}
.footer-col a:hover{color:#fff}
.footer-bottom{
  border-top:1px solid rgba(255,255,255,.08);
  padding-top:32px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:16px;
}
.footer-disclaimer{
  font-size:12px;
  color:rgba(255,255,255,.3);
  max-width:600px;
  line-height:1.5;
}
.footer-legal-links{
  display:flex;
  gap:24px;
  font-size:13px;
}
.footer-legal-links a{
  color:rgba(255,255,255,.4);
  transition:var(--transition);
}
.footer-legal-links a:hover{color:#fff}

/* ===== CART DRAWER ===== */
.cart-overlay{
  position:fixed;
  inset:0;
  background:rgba(31,31,31,.4);
  backdrop-filter:blur(4px);
  z-index:9999;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
.cart-overlay.open{opacity:1;pointer-events:auto}
.cart-drawer{
  position:fixed;
  top:0;
  right:-480px;
  width:420px;
  max-width:100%;
  height:100vh;
  background:var(--bg);
  z-index:10000;
  transition:right .4s cubic-bezier(.25,.46,.45,.94);
  display:flex;
  flex-direction:column;
  box-shadow:var(--shadow-xl);
}
.cart-drawer.open{right:0}
.cart-header{
  padding:24px 28px;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.cart-title{font-size:18px;font-weight:600;color:var(--ink)}
.cart-close{background:none;border:none;font-size:22px;cursor:pointer;color:var(--ink-muted);transition:var(--transition)}
.cart-close:hover{color:var(--ink)}
.cart-items{flex:1;overflow-y:auto;padding:28px}
.cart-empty{text-align:center;color:var(--ink-muted);padding:60px 20px;font-size:15px}
.cart-empty svg{width:48px;height:48px;margin:0 auto 16px;opacity:.3}
.cart-item{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--border-light)}
.cart-item img{width:72px;height:72px;border-radius:var(--radius-sm);object-fit:cover;background:var(--bg-warm)}
.cart-item-info{flex:1}
.cart-item-name{font-size:15px;font-weight:600;color:var(--ink)}
.cart-item-price{font-size:13px;color:var(--ink-soft);font-weight:500;margin-top:4px}
.cart-item-qty{display:flex;align-items:center;gap:12px;margin-top:8px}
.cart-item-qty button{background:var(--bg-warm);border:none;width:28px;height:28px;border-radius:8px;cursor:pointer;font-size:16px;color:var(--ink);display:flex;align-items:center;justify-content:center}
.cart-item-qty button:hover{background:var(--bg-warm2)}
.cart-item-remove{background:none;border:none;color:var(--ink-muted);cursor:pointer;font-size:14px;align-self:flex-start}
.cart-footer{padding:24px 28px;border-top:1px solid var(--border)}
.cart-subtotal{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.cart-subtotal span{font-size:15px;color:var(--ink-soft)}
.cart-subtotal strong{font-size:24px;font-weight:700;color:var(--ink)}
.btn-checkout{
  background:var(--ink);
  color:#fff;
  border:none;
  border-radius:var(--radius-pill);
  padding:16px;
  font-family:var(--font-display);
  font-size:14px;
  font-weight:600;
  cursor:pointer;
  transition:var(--transition);
  width:100%;
}
.btn-checkout:hover{background:var(--sage);transform:translateY(-1px);box-shadow:var(--shadow-md)}
.cart-note{font-size:12px;color:var(--ink-muted);text-align:center;margin-top:12px}

/* ===== SCROLL ANIMATIONS ===== */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.hero-headline,.hero-sub,.hero-cta,.hero-cards{animation:fadeUp .7s cubic-bezier(.25,.46,.45,.94) backwards}
.hero-headline{animation-delay:.1s}
.hero-sub{animation-delay:.2s}
.hero-cta{animation-delay:.3s}
.hero-cards{animation-delay:.4s}

/* ===== RESPONSIVE ===== */
@media(max-width:1024px){
  .hero{padding:60px 32px 80px}
  .hero-cards{grid-template-columns:1fr}
  .catalog-grid{grid-template-columns:repeat(2,1fr)}
  .footer-top{grid-template-columns:1fr 1fr;gap:32px}
}
@media(max-width:768px){
  .nav{padding:16px 20px}
  .nav-logo-text{font-size:20px}
  .hero{padding:40px 20px 60px}
  .hero-headline{font-size:38px}
  .hero-sub{font-size:16px}
  .compounds-section{padding:80px 20px}
  .compounds-title{font-size:32px}
  .catalog-section{padding:60px 20px}
  .catalog-grid{grid-template-columns:1fr;max-width:400px;margin:0 auto}
  .footer{padding:60px 20px 32px}
  .footer-top{grid-template-columns:1fr;gap:32px}
  .footer-bottom{flex-direction:column;align-items:flex-start}
  .cart-drawer{width:100%;right:-100%}
  .ruo-bar{font-size:10px;padding:6px 12px}
}
