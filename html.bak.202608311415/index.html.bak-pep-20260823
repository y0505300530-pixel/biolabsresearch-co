<script>
// ===== CART =====
let cart = JSON.parse(localStorage.getItem('biofirst_cart') || '[]');

function toggleCart() {
  document.getElementById('cartDrawer').classList.toggle('open');
  document.getElementById('cartOverlay').classList.toggle('open');
  renderCart();
}

function toggleMenu() {
  document.getElementById('navMenu').classList.toggle('open');
  document.getElementById('navOverlay').classList.toggle('open');
}

function addToCart(name, price, imageUrl) {
  var existing = cart.find(function(i){ return i.name === name; });
  if (existing) { existing.qty++; }
  else { cart.push({ name: name, price: price, imageUrl: imageUrl, qty: 1 }); }
  saveCart();
  renderCart();
  if (!document.getElementById('cartDrawer').classList.contains('open')) toggleCart();
}

function updateQty(name, delta) {
  var item = cart.find(function(i){ return i.name === name; });
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) cart = cart.filter(function(i){ return i.name !== name; });
  saveCart();
  renderCart();
}

function saveCart() {
  localStorage.setItem('biofirst_cart', JSON.stringify(cart));
  document.getElementById('cartCount').textContent = cart.reduce(function(a,i){ return a + i.qty; }, 0);
}

function renderCart() {
  var el = document.getElementById('cartItems');
  var total = cart.reduce(function(a,i){ return a + (parseFloat(i.price) || 0) * i.qty; }, 0);
  document.getElementById('cartTotal').textContent = '$' + total.toFixed(2);
  if (!cart.length) {
    el.innerHTML = '<div class="cart-empty"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="24" r="22"/><path d="M16 20h16l-2 12H18L16 20z"/><path d="M21 20v-4a3 3 0 016 0v4"/></svg><p>Your cart is empty.</p></div>';
    return;
  }
  el.innerHTML = cart.map(function(item) {
    return '<div class="cart-item">' +
      (item.imageUrl ? '<img src="' + item.imageUrl + '" alt="' + item.name + '">' : '') +
      '<div class="cart-item-info">' +
        '<div class="cart-item-name">' + item.name + '</div>' +
        '<div class="cart-item-price">$' + item.price + '</div>' +
        '<div class="cart-item-qty">' +
          '<button onclick="updateQty(\'' + item.name + '\',-1)">−</button>' +
          '<span>' + item.qty + '</span>' +
          '<button onclick="updateQty(\'' + item.name + '\',1)">+</button>' +
        '</div>' +
      '</div>' +
      '<button class="cart-item-remove" onclick="updateQty(\'' + item.name + '\',-99)">✕</button>' +
    '</div>';
  }).join('');
}

function checkout() {
  if (!cart.length) return;
  window.location.href = 'checkout.html';
}

document.getElementById('cartCount').textContent = cart.reduce(function(a,i){ return a + i.qty; }, 0);
</script>

<script>
// ===== PRODUCT GRID =====
(function() {
  var SLUG_MAP = {
    'wolverine-blend': 'products/bpc-157-tb-500-blend.html',
    'bpc-157-tb-500-blend': 'products/bpc-157-tb-500-blend.html',
    'nad-plus': 'products/nad-plus.html',
    'aod-9604': 'products/aod-9604.html',
    'curcumin-phytosome': 'products/curcumin-phytosome.html',
    'tesamorelin-ipamorelin': 'products/tesamorelin-ipamorelin.html',
    'bpc-157': 'products/bpc-157.html'
  };

  function renderProducts(products) {
    var grid = document.getElementById('products-grid');
    if (!grid) return;
    grid.innerHTML = '';
    products.filter(function(p){ return p.is_active !== false; }).forEach(function(p) {
      var href = SLUG_MAP[p.slug] || ('products/' + p.slug + '.html');
      var imgHtml = p.image_url
        ? '<img src="' + p.image_url + '" alt="' + p.name + '">'
        : '';
      var badgeHtml = p.badge
        ? '<div class="product-card-badge">' + p.badge + '</div>'
        : '';
      var priceHtml = '<span class="product-card-price">$' + p.price + '</span>';
      if (p.original_price) {
        priceHtml += '<span class="product-card-original">$' + p.original_price + '</span>';
      }
      var card = document.createElement('a');
      card.href = href;
      card.className = 'product-card';
      card.innerHTML =
        '<div class="product-card-img">' + imgHtml + '</div>' +
        badgeHtml +
        '<div class="product-card-name">' + p.name + '</div>' +
        priceHtml;
      grid.appendChild(card);
    });
  }

  fetch('https://biofirst.co/api/products')
    .then(function(r){ return r.json(); })
    .then(function(products) {
      localStorage.setItem('biofirst_products', JSON.stringify(products));
      renderProducts(products);
    })
    .catch(function() {
      var cached = localStorage.getItem('biofirst_products');
      if (cached) renderProducts(JSON.parse(cached));
    });
})();
</script>

